# App
APP_NAME="Telecom Vision API"
APP_VERSION="1.0.0"
DEBUG=false

# Processing
PDF_DPI=300
TILE_SIZE=640
TILE_OVERLAP=0.2
USE_GPU=true

# CORS — space-separated list of allowed origins
# Use "*" for development only
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

MAX_UPLOAD_BYTES=209715200   # 200 MB
JOB_TIMEOUT_SECONDS=1800     # 30 min
PIPELINE_WORKERS=4           # threads (fallback when Celery unavailable)
JOB_RETENTION_HOURS=24       # auto-cleanup

# Redis & Celery (Batch 3)
# Local dev: install Redis and run: redis-server
# Production: set to your managed Redis URL (e.g. Redis Cloud, ElastiCache)
REDIS_URL=redis://localhost:6379/0

# ── Cloud Integration (GCS & RunPod) ─────────────────────────────────────────
# Google Cloud Storage (Required for Cloud/RunPod deployment)
GCS_BUCKET_NAME=your-gcs-bucket-name
# The JSON string or file path for GCP credentials
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type": "service_account", ...}'

# RunPod Serverless API (Required for the Render API to wake up GPU workers)
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_runpod_serverless_endpoint_id
